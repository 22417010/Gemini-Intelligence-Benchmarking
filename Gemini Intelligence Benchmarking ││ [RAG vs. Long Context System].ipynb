import os
import time
import getpass
import numpy as np
import faiss
from google.colab import files
from openai import OpenAI
from pypdf import PdfReader
from sentence_transformers import SentenceTransformer
from rich.console import Console
from rich.panel import Panel
from rich.table import Table

console = Console()

# 2. إعداد المفتاح بأمان (Security Handling)
# هذه الطريقة تمنع تسريب مفتاحك وتسمح للمستخدمين بتشغيل الديمو بمفاتيحهم
try:
    from google.colab import userdata
    OS_API_KEY = userdata.get('OPENROUTER_API_KEY')
except Exception:
    OS_API_KEY = None

if not OS_API_KEY:
    console.print("[bold red]⚠️ لم يتم العثور على مفتاح API مخزن.[/bold red]")
    OS_API_KEY = getpass.getpass("الرجاء لصق مفتاح OpenRouter الخاص بك هنا (سيكون الإدخال مخفياً): ")

# إعداد العميل
client = OpenAI(
    base_url="https://openrouter.ai/api/v1",
    api_key=OS_API_KEY,
)

MODEL_RAG = "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
MODEL_LONG = "google/gemini-flash-1.5" # استخدام النسخة التلقائية لضمان العمل

# 3. محرك معالجة الوثائق (Document Processing Engine)
class GeminiRAGEngine:
    def __init__(self):
        self.embed_model = SentenceTransformer('all-MiniLM-L6-v2')
        self.index = None
        self.chunks = []
        self.full_text = ""

    def process_pdf(self, pdf_path):
        reader = PdfReader(pdf_path)
        text = ""
        for page in reader.pages:
            text += page.extract_text() + "\n"
        self.full_text = text
        self.chunks = [text[i:i + 800] for i in range(0, len(text), 700)]
        
        embeddings = self.embed_model.encode(self.chunks, normalize_embeddings=True)
        self.index = faiss.IndexFlatIP(embeddings.shape[1])
        self.index.add(embeddings.astype(np.float32))
        return len(self.chunks)

    def retrieve(self, query, k=3):
        query_emb = self.embed_model.encode([query], normalize_embeddings=True).astype(np.float32)
        _, indices = self.index.search(query_emb, k)
        return [self.chunks[i] for i in indices[0]]

# 4. وظيفة المقارنة المعيارية (Benchmarking Logic)
def run_benchmark(engine, query):
    # مسار الـ RAG
    start_rag = time.time()
    context_chunks = engine.retrieve(query)
    context_text = "\n---\n".join(context_chunks)
    
    rag_res = client.chat.completions.create(
        model=MODEL_RAG,
        messages=[{"role": "user", "content": f"Context: {context_text}\nQuestion: {query}"}]
    )
    time_rag = time.time() - start_rag

    # مسار الـ Long Context
    start_long = time.time()
    long_res = client.chat.completions.create(
        model=MODEL_LONG,
        messages=[{"role": "user", "content": f"Full Document Context: {engine.full_text}\nQuestion: {query}"}]
    )
    time_long = time.time() - start_long

    return {
        "rag": {"ans": rag_res.choices[0].message.content, "time": time_rag},
        "long": {"ans": long_res.choices[0].message.content, "time": time_long}
    }

# 5. واجهة التشغيل
def main():
    console.print(Panel.fit("🧪 Gemini Intelligence Benchmarking\n[RAG vs. Long Context System]", style="bold cyan"))
    
    uploaded = files.upload()
    if not uploaded: return
    file_path = list(uploaded.keys())[0]
    
    engine = GeminiRAGEngine()
    with console.status("[bold yellow]جاري بناء الفهرس..."):
        num_chunks = engine.process_pdf(file_path)
    
    while True:
        query = str(console.input("\n[bold magenta]أدخل سؤالك (أو 'exit' للخروج): [/bold magenta]"))
        if query.lower() in ['exit', 'خروج', 'quit']: break
        
        with console.status("[bold green]جاري المقارنة..."):
            results = run_benchmark(engine, query)
        
        table = Table(title="📊 المقارنة المعيارية")
        table.add_column("Metric", style="cyan")
        table.add_column("RAG Approach", style="green")
        table.add_column("Long Context", style="blue")
        table.add_row("Execution Time", f"{results['rag']['time']:.2f}s", f"{results['long']['time']:.2f}s")
        
        console.print(table)
        console.print(Panel(results['rag']['ans'], title="RAG Response", border_style="green"))
        console.print(Panel(results['long']['ans'], title="Long Context Response", border_style="blue"))

if __name__ == "__main__":
    main()
